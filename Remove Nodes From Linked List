<body>
<div class="wrap">

  <header>
    <span class="meta">LeetCode 2487 · <span class="num">Medium</span></span>
    <span class="meta">A visual essay</span>
    <span class="meta">⌬ Linked List</span>
  </header>

  <h1>
    Remove Nodes<br>
    <span class="accent-stroke">from a</span> <em>Linked&nbsp;List</em>
  </h1>

  <p class="deck">
    Given the head of a linked list, delete every node that has a greater value somewhere to its right.
    A small problem with a beautiful trick — read the list backwards.
  </p>

  <!-- ───────── PROBLEM ───────── -->
  <section>
    <div class="section-label">The problem</div>
    <h2>Keep only the <em>local champions</em>.</h2>
    <p>
      A node survives if nothing larger appears anywhere to its right. Equivalently, we want every node
      that is a <strong>maximum-from-the-right</strong> — including the final node, which trivially has nothing to its right.
    </p>

    <div class="problem-card">
      <h3>Example</h3>
      <p>Input: <code style="background:rgba(255,255,255,0.1);color:#f4ede1">5 → 2 → 13 → 3 → 8</code></p>
      <span class="rule">5 fails — 13 is larger and to its right</span><br>
      <span class="rule">2 fails — 13 is larger</span><br>
      <span class="rule">13 survives — it's the maximum</span><br>
      <span class="rule">3 fails — 8 is larger</span><br>
      <span class="rule">8 survives — nothing to its right</span>
      <p style="margin-top:18px"><strong style="color:#f4ede1">Output:</strong> <code style="background:rgba(255,255,255,0.1);color:#f4ede1">13 → 8</code></p>
    </div>
  </section>

  <!-- ───────── INSIGHT ───────── -->
  <section>
    <div class="section-label">The insight</div>
    <h2>Read it <em>backwards.</em></h2>
    <p>
      Going left-to-right, "is anything larger to my right?" forces a lookahead at every step.
      But going <strong>right-to-left</strong>, the question becomes trivial: just track the running maximum.
      A node survives only if it is at least as large as everything seen so far.
    </p>

    <div class="insight">
      Reverse the list, sweep once keeping a running max, then reverse back.
      <strong>Three passes — all linear, all in-place.</strong>
    </div>
  </section>

  <!-- ───────── ALGORITHM STEPS ───────── -->
  <section>
    <div class="section-label">The algorithm</div>
    <h2>Three moves.</h2>

    <div class="steps-grid">
      <div class="step-card">
        <div class="num">01</div>
        <h4>Reverse</h4>
        <p>Flip the list end-over-end. The last node becomes the first; iteration now flows from the original tail back to the head.</p>
      </div>
      <div class="step-card">
        <div class="num">02</div>
        <h4>Filter</h4>
        <p>Walk forward in the reversed list. Track the running max. If the next node is smaller — splice it out. Otherwise advance, updating max.</p>
      </div>
      <div class="step-card">
        <div class="num">03</div>
        <h4>Reverse again</h4>
        <p>Flip the cleaned list back. The original ordering returns, but only the survivors remain.</p>
      </div>
    </div>
  </section>

  <!-- ───────── INTERACTIVE WALKTHROUGH ───────── -->
  <section>
    <div class="section-label">Watch it run</div>
    <h2>Step through <em>5 → 2 → 13 → 3 → 8</em></h2>
    <p>Press <code>Step</code> to advance the algorithm. Each click moves the cursor one position; nodes turn green when kept, red when removed.</p>

    <div class="player">
      <div class="player-status" id="status">PHASE 0 · <span class="accent">READY</span></div>
      <div class="player-narration" id="narration">
        We start with the original list. Click <strong>Step</strong> to begin reversing.
      </div>

      <div class="max-tracker" id="maxTracker" style="visibility:hidden">
        <span class="label">Running max</span>
        <span class="val" id="maxVal">—</span>
      </div>

      <div class="list-stage">
        <div class="list-row" id="listRow"></div>
      </div>

      <div class="legend">
        <span><span class="swatch kept"></span>kept (≥ max)</span>
        <span><span class="swatch removed"></span>removed (&lt; max)</span>
        <span><span class="swatch max"></span>current max</span>
      </div>

      <div class="player-controls">
        <button class="btn primary" id="stepBtn">Step ▸</button>
        <button class="btn ghost" id="resetBtn">↺ Reset</button>
        <div class="progress-track"><div class="progress-fill" id="progress" style="width:0%"></div></div>
        <span class="mono" id="stepCounter" style="font-size:11px;color:var(--ink-soft)">0 / —</span>
      </div>
    </div>
  </section>

  <!-- ───────── CODE ───────── -->
  <section>
    <div class="section-label">The code</div>
    <h2>Clean Python.</h2>
    <p>
      Two helpers — a list reversal and a single filtering pass. The filter advances <code>curr</code> only when
      it <em>doesn't</em> splice; that way, after deleting a node, the new <code>curr.next</code> is re-examined on
      the following iteration.
    </p>

<pre class="code-block"><span class="kw">class</span> <span class="fn">Solution</span>:
    <span class="kw">def</span> <span class="fn">removeNodes</span>(self, head):
        <span class="com"># 1 ─ reverse</span>
        head = self.reverse(head)

        <span class="com"># 2 ─ sweep, dropping anything below the running max</span>
        max_val = head.val
        curr = head
        <span class="kw">while</span> curr.next:
            <span class="kw">if</span> curr.next.val &gt;= max_val:
                max_val = curr.next.val
                curr = curr.next         <span class="com"># keep + advance</span>
            <span class="kw">else</span>:
                curr.next = curr.next.next  <span class="com"># splice out, do not advance</span>

        <span class="com"># 3 ─ reverse back</span>
        <span class="kw">return</span> self.reverse(head)

    <span class="kw">def</span> <span class="fn">reverse</span>(self, head):
        prev, curr = <span class="kw">None</span>, head
        <span class="kw">while</span> curr:
            nxt = curr.next
            curr.next = prev
            prev, curr = curr, nxt
        <span class="kw">return</span> prev</pre>
  </section>

  <!-- ───────── COMPLEXITY ───────── -->
  <section>
    <div class="section-label">Cost</div>
    <h2>Linear in time, constant in space.</h2>

    <div class="complexity">
      <div>Time</div>
      <div>O(<em>n</em>)</div>
      <div>Space</div>
      <div>O(1)</div>
    </div>

    <p>Three linear passes: reverse, filter, reverse. No auxiliary structures — only pointer rewiring.</p>
  </section>

  <footer>
    <span>⌬ Linked List · LeetCode 2487</span>
    <span>End</span>
  </footer>

</div>

<script>
  // ── State machine for the visual walkthrough ──
  // Phases: 0 original → 1..n reversing animation → reversed → filter steps → final reverse → done

  const original = [5, 2, 13, 3, 8];
  const reversed = [...original].reverse(); // [8, 3, 13, 2, 5]

  // Build the precomputed step list.
  // Each step is: { phase, list, statuses, max, narration, statusLabel }
  // statuses: array of 'normal' | 'kept' | 'removed' | 'max-node'

  const steps = [];

  // Step 0: original
  steps.push({
    list: [...original],
    statuses: original.map(() => 'normal'),
    arrows: original.map(() => 'normal'),
    max: null,
    showMax: false,
    narration: 'The original list. Click <strong>Step</strong> to reverse it.',
    statusLabel: 'PHASE 0 · ORIGINAL',
  });

  // Step 1: reversed
  steps.push({
    list: [...reversed],
    statuses: reversed.map(() => 'normal'),
    arrows: reversed.map(() => 'normal'),
    max: null,
    showMax: false,
    narration: 'Reversed. We will walk forward, keeping a running max.',
    statusLabel: 'PHASE 1 · REVERSED',
  });

  // Step 2: initialize max with first node (8)
  steps.push({
    list: [...reversed],
    statuses: ['max-node', 'normal', 'normal', 'normal', 'normal'],
    arrows: reversed.map(() => 'normal'),
    max: 8,
    showMax: true,
    narration: 'Start at the first node. <strong>max = 8</strong>. The first node is always kept.',
    statusLabel: 'PHASE 2 · INIT MAX',
  });

  // Walk through the reversed list, simulating the filter.
  // We track the live list (with deletions) for display.
  let liveList = [...reversed];
  let liveStatuses = ['kept', 'normal', 'normal', 'normal', 'normal']; // 8 is kept
  let max = 8;
  let cursorIdx = 0; // index in liveList

  // Compare cursor (idx 0=8) with next (idx 1=3) → 3 < 8 → remove
  liveStatuses[1] = 'removed';
  steps.push({
    list: [...liveList],
    statuses: [...liveStatuses],
    arrows: liveList.map((_, i) => i === 0 ? 'removed' : 'normal'),
    max: 8,
    showMax: true,
    narration: 'Compare next node <strong>3</strong> with max <strong>8</strong>. 3 &lt; 8 → splice it out.',
    statusLabel: 'PHASE 2 · STEP',
  });

  // Remove 3 from liveList
  liveList = [8, 13, 2, 5];
  liveStatuses = ['kept', 'normal', 'normal', 'normal'];
  // cursor still at 8 (idx 0). Now compare with 13.
  liveStatuses[1] = 'max-node';
  max = 13;
  steps.push({
    list: [...liveList],
    statuses: [...liveStatuses],
    arrows: liveList.map(() => 'normal'),
    max: 13,
    showMax: true,
    narration: 'Next node <strong>13</strong> ≥ max. Keep it, update <strong>max = 13</strong>, advance cursor.',
    statusLabel: 'PHASE 2 · STEP',
  });

  // Now cursor at 13 (idx 1). Mark 13 as kept (was max-node, becomes kept).
  liveStatuses[1] = 'kept';
  // Compare with 2. 2 < 13 → remove.
  liveStatuses[2] = 'removed';
  steps.push({
    list: [...liveList],
    statuses: [...liveStatuses],
    arrows: liveList.map((_, i) => i === 1 ? 'removed' : 'normal'),
    max: 13,
    showMax: true,
    narration: 'Next node <strong>2</strong> &lt; 13 → splice it out.',
    statusLabel: 'PHASE 2 · STEP',
  });

  // Remove 2.
  liveList = [8, 13, 5];
  liveStatuses = ['kept', 'kept', 'normal'];
  // cursor still at 13 (idx 1). Compare with 5. 5 < 13 → remove.
  liveStatuses[2] = 'removed';
  steps.push({
    list: [...liveList],
    statuses: [...liveStatuses],
    arrows: liveList.map((_, i) => i === 1 ? 'removed' : 'normal'),
    max: 13,
    showMax: true,
    narration: 'Next node <strong>5</strong> &lt; 13 → splice it out. Nothing more to compare.',
    statusLabel: 'PHASE 2 · STEP',
  });

  // After filter
  liveList = [8, 13];
  liveStatuses = ['kept', 'kept'];
  steps.push({
    list: [...liveList],
    statuses: [...liveStatuses],
    arrows: liveList.map(() => 'normal'),
    max: 13,
    showMax: true,
    narration: 'Filter complete. Two survivors: <strong>8 → 13</strong>.',
    statusLabel: 'PHASE 2 · FILTERED',
  });

  // Reverse back
  steps.push({
    list: [13, 8],
    statuses: ['kept', 'kept'],
    arrows: [13, 8].map(() => 'normal'),
    max: null,
    showMax: false,
    narration: 'Reverse back. <strong>Final answer: 13 → 8.</strong> ✓',
    statusLabel: 'PHASE 3 · DONE',
  });

  // ── DOM rendering ──
  const listRow = document.getElementById('listRow');
  const narration = document.getElementById('narration');
  const statusEl = document.getElementById('status');
  const maxTracker = document.getElementById('maxTracker');
  const maxVal = document.getElementById('maxVal');
  const stepBtn = document.getElementById('stepBtn');
  const resetBtn = document.getElementById('resetBtn');
  const progress = document.getElementById('progress');
  const stepCounter = document.getElementById('stepCounter');

  let currentStep = 0;

  function render(step) {
    listRow.innerHTML = '';
    step.list.forEach((val, i) => {
      const node = document.createElement('div');
      node.className = 'node fade-in';
      const status = step.statuses[i];
      if (status === 'kept') node.classList.add('kept');
      else if (status === 'removed') node.classList.add('removed');
      else if (status === 'max-node') node.classList.add('max-node');
      node.textContent = val;
      node.style.animationDelay = (i * 0.04) + 's';
      listRow.appendChild(node);

      if (i < step.list.length - 1) {
        const arrow = document.createElement('div');
        arrow.className = 'arrow';
        if (step.arrows[i] === 'removed') arrow.classList.add('removed');
        listRow.appendChild(arrow);
      }
    });

    narration.innerHTML = step.narration;
    statusEl.innerHTML = step.statusLabel.replace(/·\s*([A-Z]+)$/, '· <span class="accent">$1</span>');

    if (step.showMax) {
      maxTracker.style.visibility = 'visible';
      maxVal.textContent = step.max;
    } else {
      maxTracker.style.visibility = 'hidden';
    }

    progress.style.width = ((currentStep / (steps.length - 1)) * 100) + '%';
    stepCounter.textContent = `${currentStep} / ${steps.length - 1}`;

    stepBtn.disabled = currentStep >= steps.length - 1;
    if (stepBtn.disabled) stepBtn.textContent = 'Done ✓';
    else stepBtn.textContent = 'Step ▸';
  }

  stepBtn.addEventListener('click', () => {
    if (currentStep < steps.length - 1) {
      currentStep++;
      render(steps[currentStep]);
    }
  });

  resetBtn.addEventListener('click', () => {
    currentStep = 0;
    render(steps[currentStep]);
  });

  render(steps[0]);
</script>

</body>
</html>
